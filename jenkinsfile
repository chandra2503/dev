pipeline{
    agent any
        environment{
            DOCKER_IMAGE = "chandrakalaj"
        }
    
    stages{
        stage("clone reposetory"){
            steps{
                git 'https://github.com/chandra2503/dev.git'
            }
            } 
        stage("build docker image"){
            steps{
                script{
                    sh "docker build -t ${DOCKER_IMAGE} ."
                }
            }
        }    
            stage("login docker image"){
                steps{
                    script{
                       withCredentials([usernamePassword(credentialsId: 'dockerhub', passwordVariable: 'Nuthana@2024', usernameVariable: 'chandrakalaj')]) 

                        }
                    }
                }
            stage("push docker image"){
                steps{
                        sh "docker push ${DOCKER_IMAGE}"
                    }
                }
            stage("deploy docker image"){
                    steps{
                        sh "microk8s kubectl apply -f deploymentfile.yaml"
        
                    }
                }    
            stage("deploy service"){
                steps{
                    sh "microk8s kubectl apply -f servicefile.yaml"
                }
            }
        }
    }     

  
